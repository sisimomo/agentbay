# Copy this file to .env before starting the stack:
#   cp .env.example .env

# Local PostgreSQL username. Change this if it conflicts with your setup.
POSTGRES_USER=metamcp

# Local-development password. Change this for any shared or production deployment.
POSTGRES_PASSWORD=metamcp_dev_password

# PostgreSQL database name. Change this if you use a different database name.
POSTGRES_DB=metamcp

# URL where the app is exposed. Change the port if you change docker-compose.yaml.
APP_URL=http://localhost:12008

# Secret used to sign authentication data. Generate a new value before deployment:
#   openssl rand -hex 32
BETTER_AUTH_SECRET=replace-with-output-of-openssl-rand-hex-32
