#!/usr/bin/env bash
set -euo pipefail

script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
  link_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
  script_path="$(readlink "$script_path")"
  [[ "$script_path" == /* ]] || script_path="$link_dir/$script_path"
done
repo_dir="$(cd "$(dirname "$script_path")" && pwd -P)"
vm_name=agentbay
config_file="$repo_dir/sandbox.yaml"
registry_name=agentbay-registry
registry_port=5050
image_name="localhost:$registry_port/agentbay:local"
env_file="${AGENTBAY_ENV_FILE:-$repo_dir/.env}"

usage() {
  cat <<'EOF'
Usage: ./agentbay <command>

Commands:
  build [--recreate]  Build/load the image; optionally recreate the VM
  create              Create the configured VM
  recreate            Remove and recreate the VM (keeps named volumes)
  start               Start the VM
  stop                Stop the VM
  status              Show VM status
  herdr               Run Herdr in the VM
  zsh                 Open an interactive shell in the VM
  exec -- <command>   Run a command in the VM
  ssh-setup           Configure `ssh agentbay` on the host (run by create)
  install [dir]       Symlink this CLI into dir (default: ~/.local/bin)
  help                Show this help
EOF
}

die() { printf 'agentbay: %s\n' "$*" >&2; exit 1; }

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

log_command() {
  printf '+' >&2
  printf ' %q' "$@" >&2
  printf '\n' >&2
}

run_command() { log_command "$@"; "$@"; }

load_env_file() {
  [[ -f "$env_file" ]] || return 0
  set -a
  # shellcheck disable=SC1090
  source "$env_file"
  set +a
}

escape_yaml_double_quoted() {
  local value="$1"
  value="${value//\\/\\\\}"
  value="${value//\"/\\\"}"
  value="${value//$'\n'/\\n}"
  value="${value//$'\r'/\\r}"
  value="${value//$'\t'/\\t}"
  printf '%s' "$value"
}

load_git_identity() {
  command -v git >/dev/null 2>&1 || return
  local name email
  name="$(git config --global --get user.name 2>/dev/null || true)"
  email="$(git config --global --get user.email 2>/dev/null || true)"
  export MICROSANDBOX_GIT_USER_NAME="$(escape_yaml_double_quoted "$name")"
  export MICROSANDBOX_GIT_USER_EMAIL="$(escape_yaml_double_quoted "$email")"
}

# `--root-disk flat:` only accepts images pulled from a registry (not `msb load`
# ones), so images go through a local registry. msb must also be told it is plain
# HTTP: see "Prerequisites" in README.
start_registry() {
  if [ "$(docker inspect -f '{{.State.Running}}' "$registry_name" 2>/dev/null)" = true ]; then
    return
  fi
  docker rm -f "$registry_name" >/dev/null 2>&1 || true
  run_command docker run -d --restart unless-stopped --name "$registry_name" \
    -p "127.0.0.1:$registry_port:5000" registry:2
}

build_image() {
  require_command docker
  require_command msb
  run_command docker build -f "$repo_dir/Containerfile" -t "$image_name" "$repo_dir"
  start_registry
  run_command docker push "$image_name"
  run_command msb image pull --force --insecure "$image_name"
}

create_vm() {
  require_command msb
  load_env_file
  load_git_identity
  run_command msb run -d --conf "$config_file" --name "$vm_name" \
    --root-disk flat:40G \
    --net-default-egress deny \
    --net-rule 'allow@public,allow@host:tcp:12008,allow@dns,allow@192.168.1.29:tcp:22,allow@192.168.1.121:tcp:22'
  run_command msb exec -t "$vm_name" -- /usr/local/bin/agentbay-on-create
  setup_ssh
}

# Lets the host's plain `ssh agentbay` (and scp, rsync, IDE remotes) reach the
# VM through msb's built-in SSH server; the VM itself runs no sshd. The key is
# dedicated to the VM so the user's git keys are never offered to it.
ssh_key="$HOME/.ssh/agentbay-id_ed25519"
ssh_host_config="$HOME/.ssh/config.d/agentbay"

setup_ssh() {
  require_command msb
  require_command ssh-keygen
  mkdir -p "$HOME/.ssh/config.d" "$HOME/.ssh/known_hosts.d"
  chmod 700 "$HOME/.ssh"
  if [[ ! -f "$ssh_key" ]]; then
    run_command ssh-keygen -q -t ed25519 -N '' -C "$vm_name-vm" -f "$ssh_key"
  fi
  local authorized_keys="$HOME/.microsandbox/ssh/authorized_keys"
  if ! grep -qF "$(cut -d' ' -f2 "$ssh_key.pub")" "$authorized_keys" 2>/dev/null; then
    run_command msb ssh authorize --file "$ssh_key.pub"
  fi
  # msb mints a new host key for every sandbox, so drop the pin left by the
  # previous one; accept-new re-pins on the next connection.
  rm -f "$HOME/.ssh/known_hosts.d/$vm_name"
  cat >"$ssh_host_config" <<EOF
# Generated by agentbay ssh-setup; changes are overwritten.
Host $vm_name
  User dev-ai-vm
  ProxyCommand $(command -v msb) ssh serve --stdio $vm_name
  IdentityFile $ssh_key
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
  UserKnownHostsFile ~/.ssh/known_hosts.d/$vm_name
EOF
  # Include must come before any Host block, so prepend it.
  local include_line="Include config.d/$vm_name"
  local user_config="$HOME/.ssh/config"
  if ! grep -qxF "$include_line" "$user_config" 2>/dev/null; then
    log_command prepend "$include_line" "$user_config"
    { printf '%s\n\n' "$include_line"; cat "$user_config" 2>/dev/null || true; } >"$user_config.agentbay-tmp"
    mv "$user_config.agentbay-tmp" "$user_config"
    chmod 600 "$user_config"
  fi
  printf 'agentbay: connect with `ssh %s`\n' "$vm_name" >&2
}

recreate_vm() {
  require_command msb
  run_command msb rm --force "$vm_name"
  create_vm
}

exec_vm() {
  require_command msb
  load_env_file
  run_command msb exec -t "$vm_name" -- "$@"
}

install_cli() {
  local bin_dir="${1:-$HOME/.local/bin}" target current
  target="$bin_dir/agentbay"
  mkdir -p "$bin_dir"
  if [[ -L "$target" ]]; then
    current="$(readlink "$target")"
    if [[ "$current" == "$repo_dir/agentbay" ]]; then
      printf 'Already installed: %s -> %s\n' "$target" "$current"
    else
      run_command ln -sfn "$repo_dir/agentbay" "$target"
    fi
  elif [[ -e "$target" ]]; then
    die "$target exists and is not a symlink; remove it first"
  else
    run_command ln -s "$repo_dir/agentbay" "$target"
  fi
  case ":$PATH:" in
    *":$bin_dir:"*) ;;
    *) printf 'Note: %s is not on your PATH. Add to your shell profile:\n  export PATH="%s:$PATH"\n' "$bin_dir" "$bin_dir" >&2 ;;
  esac
}

require_no_args() {
  local operation="$1"
  shift
  (( $# == 0 )) || die "$operation takes no arguments"
}

command_name="${1:-help}"
if (( $# > 0 )); then shift; fi
case "$command_name" in
  help|-h|--help) (( $# == 0 )) || die "help takes no arguments"; usage ;;
  build)
    if (( $# == 0 )); then
      build_image
    elif (( $# == 1 )) && [[ "$1" == --recreate ]]; then
      build_image
      recreate_vm
    else
      usage >&2
      die "build accepts no arguments or --recreate"
    fi
    ;;
  create) require_no_args create "$@"; create_vm ;;
  recreate) require_no_args recreate "$@"; recreate_vm ;;
  start)
    require_no_args start "$@"; require_command msb; load_env_file
    run_command msb start "$vm_name"
    # msb start does not re-run the image entrypoint (only msb run does), so
    # start Docker explicitly. on-start is idempotent.
    run_command msb exec "$vm_name" -- /usr/local/bin/agentbay-on-start
    ;;
  stop) require_no_args stop "$@"; require_command msb; run_command msb stop "$vm_name" ;;
  status) require_no_args status "$@"; require_command msb; run_command msb status "$vm_name" ;;
  herdr) require_no_args herdr "$@"; exec_vm herdr ;;
  zsh) require_no_args zsh "$@"; exec_vm zsh -l ;;
  ssh-setup) require_no_args ssh-setup "$@"; setup_ssh ;;
  install)
    (( $# <= 1 )) || die "install takes at most one directory"
    install_cli "$@"
    ;;
  exec)
    if (( $# < 2 )) || [[ "$1" != -- ]]; then
      die "exec requires -- followed by a command"
    fi
    shift
    exec_vm "$@"
    ;;
  *)
    usage >&2
    die "Unknown command: $command_name"
    ;;
esac
